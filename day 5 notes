802.1S - Multi Instance STP
"show spanning-tree mst configuration"
(displays Instances and Vlans mapped)
step 1:create VTP (VLAN Trunking Protocol)
@both switch
conf t
vtp domain ccna
vtp password pass
vtp mode server
vtp version 2
end
step 2: organize vlans
@coreTaas
conf t
vlan 11-19
exit
vlan 21-29
exit
vlan 31-39
end

@coreBABA
!enable MSTP
conf t
spanning-tree mode mst
spanning-tree mst configuration
name supermanstp
revision 1
instance  1 vlan 11-19
instance  2 vlan 21-29
instance  3 vlan 31-39
end 

sh spanning-tree mst config

!reset the root primary/secondary roles

@Rootbridge (coretaas)
conf t
spanning-tree mst 0 root primary
spanning-tree mst 1 root secondary
spanning-tree mst 2 root primary
spanning-tree mst 3 root secondary
end

@Non-Rootbridge
conf t
spanning-tree mst 0 root secondary
spanning-tree mst 1 root primary
spanning-tree mst 2 root secondary
spanning-tree mst 3 root primary
end

